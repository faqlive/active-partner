<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox spacing="8.0" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.activepartner.ui.components.ProfileBarController">
    <Label fx:id="profileLabel" text="%profile.label"/>
    <ComboBox fx:id="profileComboBox" editable="true" prefWidth="260.0"/>
    <Button fx:id="loadButton" text="%profile.load"/>
    <Button fx:id="saveButton" text="%profile.save"/>
    <Button fx:id="deleteButton" text="%profile.delete"/>
</HBox>
