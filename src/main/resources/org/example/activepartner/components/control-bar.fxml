<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox spacing="8.0" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.activepartner.ui.components.ControlBarController">
    <Button fx:id="startButton" text="%control.start"/>
    <Button fx:id="pauseButton" text="%control.pause"/>
    <Button fx:id="resumeButton" text="%control.resume"/>
    <Button fx:id="stopButton" text="%control.stop"/>
    <Label fx:id="stateTextLabel" text="%control.state"/>
    <Label fx:id="stateLabel" text="STOPPED"/>
    <Label fx:id="countTextLabel" text="%control.count"/>
    <Label fx:id="counterLabel" text="0"/>
</HBox>
